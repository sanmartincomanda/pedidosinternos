{
  "name": "app-pedidos-internos",
  "version": "1.1.20",
  "description": "Traspasos, proveedores e inventario de Carnes San Martin",
  "author": "Carnes San Martin",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "build:handheld:web": "cross-env NEXT_PUBLIC_DEVICE_PROFILE=handheld next build",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build:web && npm run android:sync",
    "android:apk": "npm run android:build && cd android && gradlew.bat assembleTabletRelease",
    "android:handheld:apk": "npm run build:handheld:web && npx cap sync android && cd android && gradlew.bat assembleHandheldRelease",
    "firebase:deploy:notifications": "firebase deploy --only functions:notificarCambioPedido --project pedidosinterno-3c65d",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "concurrently -k -s first \"next dev\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .\"",
    "desktop:start": "cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .",
    "desktop:build": "npm run build:web && electron-builder --win nsis",
    "desktop:unpacked": "npm run build:web && electron-builder --win --dir"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "firebase": "^12.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.carnessanmartin.pedidosinternos",
    "productName": "CSM Operaciones",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "out/**/*",
      "app/favicon.ico",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/favicon.ico",
      "artifactName": "CSM-Operaciones-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CSM Operaciones",
      "runAfterFinish": true
    }
  }
}
